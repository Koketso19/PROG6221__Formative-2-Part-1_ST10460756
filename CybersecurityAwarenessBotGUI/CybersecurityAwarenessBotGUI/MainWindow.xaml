<Window x:Class="CybersecurityAwarenessBotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot" Height="720" Width="1000"
        Background="#1E1E2E">

    <TabControl x:Name="tabMain" Margin="10" Background="#2A2A3C">

        <!-- CHAT TAB -->
        <TabItem Header="Chat">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#2A2A3C" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="==================================================" Foreground="#00FFCC" FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <TextBlock Text="   ____      _               _   _                 " Foreground="#00FFCC" FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <TextBlock Text="  / ___|   _| |__   ___ _ __| |_| |__   ___ _   _ " Foreground="#00FFCC" FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <TextBlock Text=" | |  | | | | '_ \ / _ \ '__| __| '_ \ / _ \ | | |" Foreground="#00FFCC" FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <TextBlock Text=" | |__| |_| | |_) |  __/ |  | |_| | | |  __/ |_| |" Foreground="#00FFCC" FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <TextBlock Text="  \____\__, |_.__/ \___|_|   \__|_| |_|\___|\__, |" Foreground="#00FFCC" FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <TextBlock Text="       |___/                                |___/ " Foreground="#00FFCC" FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <TextBlock Text="  AWARENESS BOT — PART 3 FINAL" Foreground="#00FFCC" FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <TextBlock Text="==================================================" Foreground="#00FFCC" FontFamily="Consolas" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="#2A2A3C" CornerRadius="10" Padding="10" Margin="0,0,0,15">
                    <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ChatPanel" />
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UserInputBox" Grid.Column="0" Height="40" FontSize="14" Background="#3A3A4C" Foreground="White" BorderBrush="#555" VerticalContentAlignment="Center" Padding="10,0" KeyDown="UserInputBox_KeyDown"/>
                    <Button x:Name="SendButton" Grid.Column="1" Content="Send" Width="100" Height="40" Margin="10,0,0,0" Background="#00FFCC" Foreground="Black" FontWeight="Bold" Click="SendButton_Click"/>
                </Grid>
            </Grid>
        </TabItem>

        <!-- TASKS TAB -->
        <TabItem Header="Tasks">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Task title" Foreground="White" Margin="0,0,0,4"/>
                <TextBox x:Name="txtTaskTitle" Grid.Row="1" Height="32" Background="#3A3A4C" Foreground="White" BorderBrush="#555" Padding="6,0" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="2" Text="Description" Foreground="White" Margin="0,0,0,4"/>
                <TextBox x:Name="txtTaskDescription" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" Background="#3A3A4C" Foreground="White" BorderBrush="#555" Padding="6" Margin="0,0,0,10" MinHeight="60"/>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,10">
                    <CheckBox x:Name="chkUseReminder" Content="Add reminder" Foreground="White" VerticalAlignment="Center" Checked="chkUseReminder_Changed" Unchecked="chkUseReminder_Changed"/>
                    <DatePicker x:Name="dtpReminder" Width="160" Margin="15,0,0,0" IsEnabled="False"/>
                    <Button x:Name="btnAddTask" Content="Add Task" Width="110" Height="32" Margin="15,0,0,0" Background="#00FFCC" Foreground="Black" FontWeight="Bold" Click="btnAddTask_Click"/>
                </StackPanel>

                <DataGrid x:Name="dgvTasks" Grid.Row="5" AutoGenerateColumns="True" IsReadOnly="True" Background="#2A2A3C" Foreground="White" RowBackground="#2A2A3C" AlternatingRowBackground="#33334A" HeadersVisibility="Column" Margin="0,0,0,10"/>

                <StackPanel Grid.Row="6" Orientation="Horizontal">
                    <Button x:Name="btnCompleteTask" Content="Mark Complete" Width="130" Height="32" Margin="0,0,10,0" Background="#FFC857" Foreground="Black" FontWeight="Bold" Click="btnCompleteTask_Click"/>
                    <Button x:Name="btnDeleteTask" Content="Delete" Width="100" Height="32" Margin="0,0,10,0" Background="#FF5C5C" Foreground="White" FontWeight="Bold" Click="btnDeleteTask_Click"/>
                    <Button x:Name="btnRefreshTasks" Content="Refresh" Width="100" Height="32" Background="#3A3A4C" Foreground="White" Click="btnRefreshTasks_Click"/>
                    <TextBlock x:Name="lblTaskStatus" Foreground="#00FFCC" VerticalAlignment="Center" Margin="15,0,0,0"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- QUIZ TAB -->
        <TabItem Header="Cyber Quiz">
            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock x:Name="lblQuestionNumber" Foreground="#00FFCC" FontWeight="Bold" FontSize="14"/>
                    <TextBlock x:Name="lblQuizScore" Foreground="#FFC857" FontWeight="Bold" FontSize="14" Margin="40,0,0,0"/>
                </StackPanel>

                <TextBlock x:Name="lblQuestion" Grid.Row="1" Foreground="White" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,15"/>

                <RadioButton x:Name="rdoA" Grid.Row="2" GroupName="QuizOptions" Foreground="White" Margin="0,4"/>
                <RadioButton x:Name="rdoB" Grid.Row="3" GroupName="QuizOptions" Foreground="White" Margin="0,4"/>
                <RadioButton x:Name="rdoC" Grid.Row="4" GroupName="QuizOptions" Foreground="White" Margin="0,4"/>
                <RadioButton x:Name="rdoD" Grid.Row="5" GroupName="QuizOptions" Foreground="White" Margin="0,4"/>

                <TextBlock x:Name="lblQuizFeedback" Grid.Row="6" Foreground="#00FFCC" FontStyle="Italic" TextWrapping="Wrap" Margin="0,15,0,0"/>

                <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="btnStartQuiz" Content="Start Quiz" Width="120" Height="34" Background="#00FFCC" Foreground="Black" FontWeight="Bold" Click="btnStartQuiz_Click" Margin="0,0,10,0"/>
                    <Button x:Name="btnSubmitAnswer" Content="Submit Answer" Width="130" Height="34" Background="#3A3A4C" Foreground="White" Click="btnSubmitAnswer_Click" Margin="0,0,10,0" IsEnabled="False"/>
                    <Button x:Name="btnNextQuestion" Content="Next" Width="100" Height="34" Background="#3A3A4C" Foreground="White" Click="btnNextQuestion_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ACTIVITY LOG TAB -->
        <TabItem Header="Activity Log">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Recent activity (most recent first)" Foreground="White" Margin="0,0,0,10"/>
                <ListBox x:Name="lstActivity" Grid.Row="1" Background="#2A2A3C" Foreground="White" BorderBrush="#555" FontFamily="Consolas"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="btnRefreshActivity" Content="Refresh" Width="110" Height="32" Background="#3A3A4C" Foreground="White" Click="btnRefreshActivity_Click" Margin="0,0,10,0"/>
                    <Button x:Name="btnShowMore" Content="Show More (10)" Width="140" Height="32" Background="#00FFCC" Foreground="Black" FontWeight="Bold" Click="btnShowMore_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>

    </TabControl>
</Window>
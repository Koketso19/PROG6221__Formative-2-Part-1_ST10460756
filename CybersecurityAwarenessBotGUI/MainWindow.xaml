<Window x:Class="CybersecurityAwarenessBotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot" Height="650" Width="850"
        Background="#1E1E2E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / ASCII Art -->
        <Border Grid.Row="0" Background="#2A2A3C" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="==================================================" Foreground="#00FFCC" FontFamily="Consolas" HorizontalAlignment="Center"/>
                <TextBlock Text="   ____      _               _   _                 " Foreground="#00FFCC" FontFamily="Consolas" HorizontalAlignment="Center"/>
                <TextBlock Text="  / ___|   _| |__   ___ _ __| |_| |__   ___ _   _ " Foreground="#00FFCC" FontFamily="Consolas" HorizontalAlignment="Center"/>
                <TextBlock Text=" | |  | | | | '_ \ / _ \ '__| __| '_ \ / _ \ | | |" Foreground="#00FFCC" FontFamily="Consolas" HorizontalAlignment="Center"/>
                <TextBlock Text=" | |__| |_| | |_) |  __/ |  | |_| | | |  __/ |_| |" Foreground="#00FFCC" FontFamily="Consolas" HorizontalAlignment="Center"/>
                <TextBlock Text="  \____\__, |_.__/ \___|_|   \__|_| |_|\___|\__, |" Foreground="#00FFCC" FontFamily="Consolas" HorizontalAlignment="Center"/>
                <TextBlock Text="       |___/                                |___/ " Foreground="#00FFCC" FontFamily="Consolas" HorizontalAlignment="Center"/>
                <TextBlock Text="            AWARENESS BOT - PART 2" Foreground="#00FFCC" FontFamily="Consolas" HorizontalAlignment="Center"/>
                <TextBlock Text="==================================================" Foreground="#00FFCC" FontFamily="Consolas" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Chat Display Area -->
        <Border Grid.Row="1" Background="#2A2A3C" CornerRadius="10" Padding="10" Margin="0,0,0,15">
            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChatPanel" />
            </ScrollViewer>
        </Border>

        <!-- Input Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UserInputBox" Grid.Column="0" Height="40" FontSize="14" 
                     Background="#3A3A4C" Foreground="White" BorderBrush="#555" 
                     VerticalContentAlignment="Center" Padding="10,0" KeyDown="UserInputBox_KeyDown"/>
            <Button x:Name="SendButton" Grid.Column="1" Content="Send" Width="100" Height="40" 
                    Margin="10,0,0,0" Background="#00FFCC" Foreground="Black" FontWeight="Bold" Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>